# Arch desktop (Hyprland) only. Sourced at the end of ~/.zshrc.

alias icat="kitty +kitten icat"
alias locate=plocate
alias paclog='paclog -c'
alias spt=~/projects/spotify-tui/target/debug/spt # point @ own copy
alias tmux='WAYLAND_DISPLAY=$WAYLAND_DISPLAY tmux'

# fuzzy search and install yay packages
function fyayi() {
    yay -Slq | fzf -q "$1" -m --preview 'yay -Si {1}'| xargs -ro yay -S
}

# fuzzy search and remove yay packages
function fyayu() {
    yay -Qq | fzf -q "$1" -m --preview 'yay -Qi {1}' | xargs -ro yay -Rns
}
