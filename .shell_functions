#!/bin/bash

function google() {
    BASE_URL="https://duckduckgo.com/?q="
    SEARCH_STRING=$(sed 's/ /+/g' <<< $@)
    w3m ${BASE_URL}${SEARCH_STRING}
}

# fuzzy search and install yay packages
function fyayi() {                                                                                                                  [16:12:12]
    yay -Slq | fzf -q "$1" -m --preview 'yay -Si {1}'| xargs -ro yay -S
}

# fuzzy search and remove yay packages
function fyayu() {
    yay -Qq | fzf -q "$1" -m --preview 'yay -Qi {1}' | xargs -ro yay -Rns
}

# workaround for uv not tab completing
function uvrun() {
    uv run $1
}

# yazi start with "y", drop to cwd on exit
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}
